---
import EntryArticle from "../../components/EntryArticle.astro";
import { comment } from "../../consts";
import { getCollectionByName } from "../../utils/getCollectionByName";
import { sortPostsByDate } from "../../utils/sortPostsByDate";
import { getPrevNext } from "../../utils/getPrevNext";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollectionByName("journal");
  return entries.map((entry) => ({
    params: { entry: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const entries = await getCollectionByName("journal");
const { prevPost, nextPost } = getPrevNext(sortPostsByDate(entries), entry);
---

<EntryArticle
  entry={entry}
  breadcrumb={{ icon: "ri-chat-thread-line", href: "/journal", label: "Journal" }}
  prevPost={prevPost}
  nextPost={nextPost}
  articleClass="markdown-body scroll-smooth mb-4 e-content"
>
  <Fragment slot="after-title">
    <div class="flex items-center mb-2">
      {comment.enable && comment.type === "waline" && comment.pageview}
    </div>
    {entry.data.externalUrl && (
      <p class="text-sm mb-2">
        <span>In response to: </span>
        {/* u-in-reply-to marks this as a genuine reply, so a receiving site
            can display it as one rather than a bare mention. */}
        <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer"
           class="u-in-reply-to header-link-active underline-offset-4 cursor-pointer decoration-skin-base decoration-wavy hover:underline hover:decoration-sky-500">
          <i class="ri-external-link-line" /> {entry.data.externalTitle || entry.data.externalUrl}
        </a>
      </p>
    )}
  </Fragment>
</EntryArticle>
