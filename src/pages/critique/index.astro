---

import IndexPage from '../../layouts/IndexPage.astro'
import { sortPostsByDate } from "../../utils/sortPostsByDate";
import { getCollectionByName } from "../../utils/getCollectionByName";
import FeedPreview from "../../components/FeedPreview.astro";

let posts = await getCollectionByName("critique");
posts = sortPostsByDate(posts);

---

<IndexPage frontmatter={{ comment: false, title: "Critique" }}>
  <h1 class="text-3xl fa-2x mb-5 mt-10">Critique</h1>

  <p class="mb-5">Short critical responses to posts, talks, books, and other things worth engaging with. Each entry links to the source so you can read the original alongside my take.</p>

  <p class="mb-10">You can get new entries in your favorite RSS reader via <a class="truncate mt-1 header-link-active cursor-pointer decoration-skin-base hover:text-skin-active" href="/critique/rss.xml">the dedicated RSS feed</a>.</p>
  <div class="divider-horizontal"/>

  {posts.map((post, index) => <FeedPreview post={post} index={index} />)}
</IndexPage>
