---
import { render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import NotesTitle from "../../components/NotesTitle.astro";
import PostNavigation from "../../components/PostNavigation.astro";
import { getCollectionByName } from "../../utils/getCollectionByName";
import { sortNotesByZettelId } from "../../utils/sortNotesByZettelId";
import { getPrevNext } from "../../utils/getPrevNext";
import NotesFooter from "../../components/NotesFooter.astro";
import Webmentions from "../../components/Webmentions.astro";

export const prerender = true;

export async function getStaticPaths() {
  const notesEntries = await getCollectionByName("notes");
  return notesEntries.map((entry) => ({
    params: { note: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const id = entry.id;
const { Content } = await render(entry);

const allNotes = await getCollectionByName("notes");
const sortPosts = sortNotesByZettelId(allNotes);
const { prevPost, nextPost } = getPrevNext(sortPosts, entry);

// Backlinks: every note whose body links to this one.
const linkRegex = /\[.*?\]\((.*?)\)/g;
const pathname = `/notes/${id}/`;
const backlinks = allNotes
  .filter((note) =>
    // A note that is still a frontmatter-only stub has no body; without this the
    // whole build dies on the first empty note.
    [...(note.body ?? "").matchAll(linkRegex)].some((link) => link[1] === pathname),
  )
  .map((note) => ({ frontmatter: note.data, url: `/notes/${note.id}` }));
---

<BlogPost frontmatter={entry.data}>
  <!-- The h-entry spans the footer as well, so the dates rendered there are read
       as this note's dt-published / dt-updated rather than as loose markup. -->
  <div class="h-entry">
    <div>
      <NotesTitle {...entry.data} title={`${entry.data.zettelId}: ${entry.data.title}`} />
      <div class="divider-horizontal"></div>
      <article class="markdown-body e-content">
        <Content />
      </article>
    </div>

    <PostNavigation
      class="mt-10"
      linkClass="colored-link hover:text-skin-active"
      prevPost={prevPost}
      nextPost={nextPost}
      prevLabel={prevPost && prevPost.data.zettelId + ": " + prevPost.data.title}
      nextLabel={nextPost && nextPost.data.zettelId + ": " + nextPost.data.title}
    />
    <!-- Backlinks are part of the article -->
    {backlinks.length > 0 && <h4 class="mt-5 font-bold">This note is mentioned in: </h4>}
    {
      backlinks.length > 0 &&
        backlinks.map((backlink) => (
          <span>
            <a href={backlink.url} class="colored-link italic cursor-pointer mt-1 hover:text-skin-active">
              {backlink.frontmatter.zettelId}.
            </a>{" "}
          </span>
        ))
    }
    <NotesFooter
      date={entry.data.date}
      updateDate={entry.data.updateDate}
    />
  </div>
  <Webmentions />
</BlogPost>
